# Single source of truth for the book's build toolchain versions.
#
# Plain KEY=value data, no logic. Sourceable by shell (`. scripts/versions.env`)
# and simple enough for anything else to parse if a non-shell consumer shows up.
#
# Read by:
#   - scripts/setup-local.sh   (local development)
#   - vercel-build.sh          (production build)
#   - .github/workflows/CI.yml (the `check` job)
#
# Keep mdbook-kcl/Cargo.toml's mdbook-preprocessor dependency compatible with
# MDBOOK_VERSION when updating the toolchain.

MDBOOK_VERSION=0.5.4
MDBOOK_TOC_VERSION=0.15.4
